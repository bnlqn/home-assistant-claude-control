#!/usr/bin/env bash
set -euo pipefail

TOKEN="$(
  security find-generic-password \
    -a "$USER" \
    -s "claude-homeassistant-api-token" \
    -w
)"

HA_MCP_TOKEN="$TOKEN" python3 - <<'PY'
import json
import os

print(json.dumps({
    "Authorization": "Bearer " + os.environ["HA_MCP_TOKEN"]
}))
PY
