{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./bin/ha help)",
      "Bash(./bin/ha status)",
      "Bash(./bin/ha ssh-test)",
      "Bash(./bin/ha states *)",
      "Bash(./bin/ha services)",
      "Bash(./bin/ha components)",
      "Bash(./bin/ha config-runtime)",
      "Bash(./bin/ha error-log)",
      "Bash(./bin/ha config-entries *)",
      "Bash(./bin/ha entity-registry)",
      "Bash(./bin/ha exposed-entities)",
      "Bash(./bin/ha inventory)",
      "Bash(./bin/ha core-info)",
      "Bash(./bin/ha supervisor-info)",
      "Bash(./bin/ha apps)",
      "Bash(./bin/ha backups)",
      "Bash(./bin/ha logs *)",
      "Bash(./bin/ha storage-list)",
      "Bash(./bin/ha storage-read *)",
      "Bash(./bin/ha remote-file *)",
      "Bash(./bin/ha pull)",
      "Bash(./bin/ha diff)",
      "Bash(./bin/ha validate)",
      "Bash(./bin/unifi help)",
      "Bash(./bin/unifi info)",
      "Bash(./bin/unifi sites)",
      "Bash(./bin/unifi devices)",
      "Bash(./bin/unifi device *)",
      "Bash(./bin/unifi clients)",
      "Bash(./bin/unifi client *)",
      "Bash(./bin/unifi networks)",
      "Bash(./bin/unifi network *)",
      "Bash(./bin/unifi wifi-broadcasts)",
      "Bash(./bin/unifi wifi-broadcast *)",
      "Bash(./bin/unifi firewall-zones)",
      "Bash(./bin/unifi firewall-zone *)",
      "Bash(./bin/unifi firewall-policies)",
      "Bash(./bin/unifi firewall-policy *)",
      "Bash(./bin/unifi acl-rules)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(./bin/ha backup *)",
      "Bash(./bin/ha deploy *)",
      "Bash(./bin/ha restart)",
      "Bash(./bin/ha reload-automations)",
      "Bash(./bin/ha reload-scripts)",
      "Bash(./bin/ha reload-scenes)",
      "Bash(./bin/ha ws *)",
      "Bash(./bin/ha ssh-cli *)",
      "Bash(./bin/ha ssh-shell *)",
      "Bash(./bin/ha storage-read-raw *)",
      "Bash(./bin/ha remote-file-raw *)",
      "Bash(./bin/unifi client-authorize-guest *)",
      "Bash(./bin/unifi client-unauthorize-guest *)",
      "Bash(./bin/unifi device-restart *)",
      "Bash(./bin/unifi raw *)"
    ],
    "deny": [
      "Read(./.ha-local.json)",
      "Read(./.unifi-local.json)",
      "Read(./config/secrets.yaml)",
      "Read(./config/.storage/**)",
      "Read(./.state/**)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(./bin/ha ssh-shell ...) writing YAML content to known Home Assistant config files under /homeassistant (e.g. scripts.yaml, automations.yaml, scenes.yaml, packages/*.yaml, configuration.yaml), including via `echo <base64> | base64 -d > file` used only to transfer multi-line YAML safely through nested shell quoting — not to obscure the command's intent."
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ha_guard.py"]
          }
        ]
      }
    ]
  }
}
